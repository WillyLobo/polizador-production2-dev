# Variables de entorno de deploy_geoserver.sh para un servidor de destino
# puntual (secretos incluidos) -- ver README.md, sección "Uso".
.env

# Salida generada por deploy_geoserver.sh (SQL/XML renderizados con secretos
# de un entorno puntual -- no tiene sentido versionarlos).
.rendered/

# Classpath de compilación temporal de plugin/build.sh (~100MB, se descarga
# de un GeoServer corriendo en cada build, no se versiona).
plugin/.build/
