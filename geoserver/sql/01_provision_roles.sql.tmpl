-- Roles de Postgres que necesita GeoServer: uno para el datastore (lee/escribe
-- las capas publicadas) y otro solo de lectura para el servicio de roles JDBC
-- (lee las vistas geoserver_auth.roles / geoserver_auth.user_roles).
--
-- Requiere privilegios de superusuario de Postgres (CREATE ROLE). Generado por
-- deploy_geoserver.sh a partir de este template -- no editar el .sql renderizado
-- a mano, editar el template y volver a correr el deploy.
--
-- Idempotente: se puede correr de nuevo (por ejemplo para rotar contraseñas)
-- sin duplicar roles.

\set ON_ERROR_STOP on

DO $do$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'geoserver_piloto') THEN
    CREATE ROLE geoserver_piloto LOGIN PASSWORD '__GEOSERVER_DS_PASSWORD__';
  ELSE
    ALTER ROLE geoserver_piloto PASSWORD '__GEOSERVER_DS_PASSWORD__';
  END IF;

  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'geoserver_security') THEN
    CREATE ROLE geoserver_security LOGIN PASSWORD '__GEOSERVER_SECURITY_DB_PASSWORD__';
  ELSE
    ALTER ROLE geoserver_security PASSWORD '__GEOSERVER_SECURITY_DB_PASSWORD__';
  END IF;
END
$do$;
